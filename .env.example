# ============================================================
# ClaudeClaw — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ── REQUIRED ────────────────────────────────────────────────

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Your Telegram chat ID (send /chatid to your bot after first run)
ALLOWED_CHAT_ID=

# ── VOICE: STT (Speech-to-Text) ─────────────────────────────

# Groq API key for Whisper transcription (free at console.groq.com)
GROQ_API_KEY=

# ── VOICE: TTS (Text-to-Speech) ─────────────────────────────

# ElevenLabs API key (free tier at elevenlabs.io)
ELEVENLABS_API_KEY=

# ElevenLabs voice ID (find it in your ElevenLabs dashboard)
ELEVENLABS_VOICE_ID=

# ── VIDEO ANALYSIS ──────────────────────────────────────────

# Google API key for Gemini video analysis (free at aistudio.google.com)
GOOGLE_API_KEY=

# ── OPTIONAL ────────────────────────────────────────────────

# Log level: trace | debug | info | warn | error (default: info)
# LOG_LEVEL=info
