{
  "queries": [
    {
      "q": "echo to terminal",
      "type": "direct",
      "expected": ["echo", "secho", "echo_via_pager"]
    },
    {
      "q": "create a command",
      "type": "direct",
      "expected": ["command", "group", "Command", "Group"]
    },
    {
      "q": "invoke a callback",
      "type": "direct",
      "expected": ["invoke", "forward", "Context.invoke", "Command.invoke"]
    },
    {
      "q": "abort with exit",
      "type": "direct",
      "expected": ["abort", "exit", "fail", "Abort", "Exit", "Context.abort", "Context.exit"]
    },
    {
      "q": "format the help text",
      "type": "direct",
      "expected": ["get_help", "format_help", "make_formatter", "HelpFormatter", "Command.format_help"]
    },

    {
      "q": "print colored output",
      "type": "indirect",
      "expected": ["echo", "secho", "style"]
    },
    {
      "q": "ask user for input",
      "type": "indirect",
      "expected": ["prompt", "confirm"]
    },
    {
      "q": "open the editor",
      "type": "indirect",
      "expected": ["edit", "launch", "Editor"]
    },
    {
      "q": "show error message",
      "type": "indirect",
      "expected": ["fail", "abort", "UsageError", "ClickException", "show"]
    },
    {
      "q": "list available commands",
      "type": "indirect",
      "expected": ["_complete_visible_commands", "list_commands", "Group.list_commands"]
    }
  ]
}
